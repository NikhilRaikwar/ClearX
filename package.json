{
  "name": "clearx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run contracts:compile && tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:web": "tsc -b && vite build",
    "start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:contracts": "hardhat test",
    "test:e2e": "playwright test",
    "contracts:compile": "hardhat compile",
    "deploy:coston2": "hardhat run scripts/deploy.ts --network coston2",
    "xrpl:pay": "tsx scripts/xrpl-pay.ts"
  },
  "dependencies": {
    "@gemwallet/api": "3.8.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tanstack/react-query": "^5.85.5",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "viem": "^2.37.3",
    "wagmi": "^2.16.7",
    "xrpl": "^4.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@flarenetwork/flare-periphery-contract-artifacts": "^0.1.52",
    "@flarenetwork/flare-periphery-contracts": "^0.1.52",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@typechain/hardhat": "^9.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "chai": "^4.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "ethers": "^6.15.0",
    "globals": "^16.3.0",
    "hardhat": "^2.26.3",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typechain": "^8.3.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
