# Application
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
VITE_API_BASE_URL=/api
VITE_CLEARX_MOCK_MODE=false

# Display-only market reference (public, no API key)
MARKET_PRICE_URL=https://api.coinbase.com/v2/prices/XRP-USD/spot

# Flare Coston2
COSTON2_CHAIN_ID=114
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_WS_URL=wss://coston2-api.flare.network/ext/C/ws
COSTON2_EXPLORER_URL=https://coston2-explorer.flare.network
COSTON2_SYSTEMS_EXPLORER_URL=https://coston2-systems-explorer.flare.network
COSTON2_FAUCET_URL=https://faucet.flare.network/coston2

# ClearX deployment (verified Coston2 values are filled after deployment)
USDT0_ADDRESS=
CLEARX_CONTRACT_ADDRESS=
CLEARX_DEPLOYMENT_BLOCK=
DEPLOYER_PRIVATE_KEY=

# Flare Data Connector
FDC_VERIFIER_BASE_URL=https://fdc-verifiers-testnet.flare.network
FDC_DA_LAYER_URL=https://ctn2-data-availability.flare.network
FDC_VERIFIER_API_KEY=00000000-0000-0000-0000-000000000000
FDC_RELAYER_PRIVATE_KEY=
FDC_POLL_INTERVAL_MS=7000
FDC_JOB_TIMEOUT_MS=900000

# XRP Ledger Testnet
XRPL_TESTNET_RPC=https://s.altnet.rippletest.net:51234/
XRPL_TESTNET_WS=wss://s.altnet.rippletest.net:51233/
XRPL_TESTNET_EXPLORER_TX_BASE_URL=https://testnet.xrpl.org/transactions/

# Persistent server state
JOB_DB_PATH=./data/clearx.sqlite
FDC_START_RATE_LIMIT_PER_HOUR=5
